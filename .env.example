# Coolify Environment Variables
# Copy this to .env and configure for local testing
# In Coolify, set these in the Environment Variables section

# Database (Coolify manages these if using built-in PostgreSQL)
POSTGRES_USER=backstage
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=backstage

# URLs - Coolify sets these automatically based on your domain
APP_BASE_URL=https://your-domain.com
BACKEND_BASE_URL=https://your-domain.com

# Optional: GitHub Integration
# Create a token at https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx
