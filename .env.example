# Copia este archivo como .env (git lo ignora) y completa los valores.

# OAuth App de la organización DevHRL: login con GitHub.
# github.com/organizations/DevHRL/settings/applications -> New OAuth App
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# Base local en Docker (compose.yaml). Opcional: si se dejan vacías, iniciar.ps1
# y compose.yaml usan backstage/backstage. Solo escucha en 127.0.0.1:5433.
POSTGRES_USER=
POSTGRES_PASSWORD=

# Token de solo lectura para que el portal lea los repos y los miembros de DevHRL.
# Si se deja vacío, iniciar.ps1 usa el de GitHub CLI (gh auth token).
GITHUB_TOKEN=
